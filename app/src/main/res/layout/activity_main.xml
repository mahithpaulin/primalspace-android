<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1210"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIMALSPACE"
            android:textColor="#C9F36B"
            android:textSize="13sp"
            android:letterSpacing="0.18"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Your device, working together."
            android:textColor="#F4F6F1"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Not connected"
            android:textColor="#9AA59C"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="#6E7A71"
            android:textSize="12sp" />
        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Connect to PrimalSpace"
            android:backgroundTint="#C9F36B"
            android:textColor="#0E1210" />
        <Button
            android:id="@+id/compute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Enable compute"
            android:backgroundTint="#1C241F"
            android:textColor="#F4F6F1" />
        <Button
            android:id="@+id/sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sync now"
            android:backgroundTint="#1C241F"
            android:textColor="#F4F6F1" />
        <Button
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Allow background running"
            android:backgroundTint="#1C241F"
            android:textColor="#F4F6F1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="MESSAGES"
            android:textColor="#C9F36B"
            android:textSize="13sp"
            android:letterSpacing="0.18"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/message_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#C9F36B"
            android:spinnerMode="dropdown" />
        <EditText
            android:id="@+id/message_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#3A463D"
            android:hint="Message"
            android:textColor="#F4F6F1"
            android:textColorHint="#6E7A71"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLines="4" />
        <Button
            android:id="@+id/message_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Send message"
            android:backgroundTint="#1C241F"
            android:textColor="#F4F6F1" />
        <TextView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text=""
            android:textColor="#9AA59C"
            android:textSize="12sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Compute is off by default. Enable it only when you want this device to accept work. The worker runs as a foreground service so Android keeps it alive. You can disable it at any time."
            android:textColor="#6E7A71"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
