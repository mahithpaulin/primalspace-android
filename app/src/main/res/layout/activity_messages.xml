<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1210"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MESSAGES"
        android:textColor="#C9F36B"
        android:textSize="13sp"
        android:letterSpacing="0.18"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/peers_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Loading peers…"
        android:textColor="#6E7A71"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/message_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#C9F36B"
        android:spinnerMode="dropdown" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <TextView
            android:id="@+id/message_thread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No messages yet."
            android:textColor="#9AA59C"
            android:textSize="13sp" />
    </ScrollView>

    <EditText
        android:id="@+id/message_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#3A463D"
        android:hint="Message"
        android:inputType="text"
        android:maxLines="4"
        android:textColor="#F4F6F1"
        android:textColorHint="#6E7A71"
        android:textSize="14sp" />

    <Button
        android:id="@+id/message_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Send"
        android:backgroundTint="#C9F36B"
        android:textColor="#0E1210" />
    <Button
        android:id="@+id/close_messages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Close"
        android:backgroundTint="#1C241F"
        android:textColor="#F4F6F1" />
</LinearLayout>
