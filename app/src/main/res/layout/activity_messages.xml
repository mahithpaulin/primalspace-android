<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/msg_bg">

    <LinearLayout
        android:id="@+id/chat_list_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_messages_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/messages_self_avatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_avatar_primal"
                android:gravity="center"
                android:text="PS"
                android:textColor="#0B141A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="PrimalSpace"
                    android:textColor="@color/msg_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Community messenger"
                    android:textColor="@color/msg_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/messages_new_group"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="#1E3A32"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="New group"
                android:textColor="@color/msg_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/conversation_search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_messages"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:drawableTint="#8696A0"
            android:hint="Search conversations"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/msg_text"
            android:textColorHint="#8696A0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/messages_sync_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="Syncing conversations…"
            android:textColor="#667781"
            android:textSize="11sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/conversation_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp" />
        </ScrollView>

        <include layout="@layout/nav_bar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/thread_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/msg_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_thread_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="8dp">

            <ImageButton
                android:id="@+id/thread_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to chats"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:tint="@color/msg_text" />

            <TextView
                android:id="@+id/thread_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#2A3942"
                android:gravity="center"
                android:text="PS"
                android:textColor="@color/msg_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/thread_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="PrimalSpace"
                    android:textColor="@color/msg_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/thread_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Community broadcasts"
                    android:textColor="@color/msg_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/message_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/message_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_thread_composer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="7dp">

            <EditText
                android:id="@+id/message_body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_messages"
                android:gravity="center_vertical"
                android:hint="Message"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/msg_text"
                android:textColorHint="#8696A0"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/message_send"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_send_button"
                android:contentDescription="Send message"
                android:padding="13dp"
                android:src="@drawable/ic_send"
                android:tint="#0B141A" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
