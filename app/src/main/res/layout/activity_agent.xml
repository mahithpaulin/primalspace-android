<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1210"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRIMAL AGENT"
        android:textColor="#C9F36B"
        android:textSize="13sp"
        android:letterSpacing="0.18"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/agent_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Not signed in with ChatGPT"
        android:textColor="#9AA59C"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/agent_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Agent name"
        android:inputType="text"
        android:textColor="#E6EDE7"
        android:textColorHint="#6E7A71"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/agent_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Model (blank = account default)"
        android:inputType="text"
        android:textColor="#E6EDE7"
        android:textColorHint="#6E7A71"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/agent_login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Continue with ChatGPT"
            android:textSize="11sp" />

        <Button
            android:id="@+id/agent_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/agent_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start agent"
            android:textSize="11sp" />

        <Button
            android:id="@+id/agent_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stop agent"
            android:textSize="11sp" />

        <Button
            android:id="@+id/agent_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Refresh"
            android:textSize="11sp" />

        <Button
            android:id="@+id/agent_signout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sign out"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="GROUP CHATS"
        android:textColor="#6E7A71"
        android:textSize="11sp"
        android:letterSpacing="0.14"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <TextView
            android:id="@+id/agent_groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No group chats yet."
            android:textColor="#9AA59C"
            android:textSize="12sp" />
    </ScrollView>

    <Button
        android:id="@+id/close_agent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Close"
        android:textSize="11sp" />
</LinearLayout>
