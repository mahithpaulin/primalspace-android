<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_ink"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="SETTINGS"
                android:textColor="#AAB6C2"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Node identity"
                android:textColor="#EEF2F5"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Connection, profile and background policy."
                android:textColor="@color/settings_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_settings"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="CONNECTION"
                    android:textColor="#AAB6C2"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Operator enrollment key"
                    android:textColor="#EEF2F5"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/enrollment_key"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_settings"
                    android:hint="Enrollment key"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="#EEF2F5"
                    android:textColorHint="#6F7B82"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/settings_connect"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:backgroundTint="#AAB6C2"
                        android:text="Reconnect"
                        android:textAllCaps="false"
                        android:textColor="#0D1012"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/save_settings"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:backgroundTint="#242C30"
                        android:text="Save"
                        android:textAllCaps="false"
                        android:textColor="#DDE4E8"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/settings_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Not connected."
                    android:textColor="@color/settings_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_settings"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="PROFILE"
                    android:textColor="#AAB6C2"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_settings"
                    android:hint="Display name"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="#EEF2F5"
                    android:textColorHint="#6F7B82"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/profile_status"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_settings"
                    android:hint="Status line"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="#EEF2F5"
                    android:textColorHint="#6F7B82"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/profile_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_settings"
                    android:hint="Avatar initials (max 2)"
                    android:inputType="text"
                    android:maxLength="2"
                    android:paddingHorizontal="14dp"
                    android:textColor="#EEF2F5"
                    android:textColorHint="#6F7B82"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_settings"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="DEVICE"
                    android:textColor="#AAB6C2"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Device id: —"
                    android:textColor="@color/settings_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/settings_server"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Server: —"
                    android:textColor="@color/settings_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/settings_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Version: —"
                    android:textColor="@color/settings_muted"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/settings_background"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="#242C30"
                    android:text="Allow background running"
                    android:textAllCaps="false"
                    android:textColor="#DDE4E8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="PrimalSpace · compute and messaging with consent."
                android:textColor="#58636A"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/nav_bar" />
</LinearLayout>
