<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1210"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textColor="#C9F36B"
            android:textSize="13sp"
            android:letterSpacing="0.18"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Compute mode"
            android:textColor="#F4F6F1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <RadioButton
                android:id="@+id/mode_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Off — never compute"
                android:textColor="#F4F6F1"
                android:textSize="14sp" />
            <RadioButton
                android:id="@+id/mode_ondemand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On demand — compute only when I turn it on"
                android:textColor="#F4F6F1"
                android:textSize="14sp" />
            <RadioButton
                android:id="@+id/mode_lend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lend — active compute, earns CU"
                android:textColor="#F4F6F1"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start lending automatically every time the app opens"
            android:textColor="#F4F6F1"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/auto_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <RadioButton
                android:id="@+id/auto_lend_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yes (default)"
                android:textColor="#F4F6F1"
                android:textSize="14sp" />
            <RadioButton
                android:id="@+id/auto_lend_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No — ask me each time"
                android:textColor="#F4F6F1"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Lending terms"
            android:textColor="#F4F6F1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/lend_cpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3A463D"
            android:hint="CPU to lend (%)"
            android:inputType="number"
            android:textColor="#F4F6F1"
            android:textColorHint="#6E7A71"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/lend_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3A463D"
            android:hint="Minutes per hour to lend"
            android:inputType="number"
            android:textColor="#F4F6F1"
            android:textColorHint="#6E7A71"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/lend_units"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3A463D"
            android:hint="CU earned per hour of compute"
            android:inputType="numberDecimal"
            android:textColor="#F4F6F1"
            android:textColorHint="#6E7A71"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Maximum compute (minutes, 0 = unlimited)"
            android:textColor="#F4F6F1"
            android:textSize="18sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/cap_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3A463D"
            android:hint="Per day"
            android:inputType="number"
            android:textColor="#F4F6F1"
            android:textColorHint="#6E7A71"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/cap_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3A463D"
            android:hint="Per week"
            android:inputType="number"
            android:textColor="#F4F6F1"
            android:textColorHint="#6E7A71"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/cap_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3A463D"
            android:hint="Per month"
            android:inputType="number"
            android:textColor="#F4F6F1"
            android:textColorHint="#6E7A71"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Profile"
            android:textColor="#F4F6F1"
            android:textSize="18sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3A463D"
            android:hint="Display name"
            android:inputType="text"
            android:textColor="#F4F6F1"
            android:textColorHint="#6E7A71"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/profile_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3A463D"
            android:hint="Status message"
            android:inputType="text"
            android:textColor="#F4F6F1"
            android:textColorHint="#6E7A71"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/profile_avatar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#3A463D"
            android:hint="Avatar (emoji)"
            android:inputType="text"
            android:textColor="#F4F6F1"
            android:textColorHint="#6E7A71"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/settings_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#9AA59C"
            android:textSize="13sp" />

        <Button
            android:id="@+id/save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Save settings"
            android:backgroundTint="#C9F36B"
            android:textColor="#0E1210" />
        <Button
            android:id="@+id/close_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Close"
            android:backgroundTint="#1C241F"
            android:textColor="#F4F6F1" />
    </LinearLayout>
</ScrollView>
